{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pallando-wow/wow-development-data/schemas/datasets/entity-observations.schema.json",
  "title": "Pallando WoW Entity Observations Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "kind",
    "clientId",
    "generatedAt",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "api",
        "event",
        "quest",
        "spell",
        "item",
        "npc",
        "map",
        "faction",
        "achievement",
        "profession",
        "pet-family",
        "pet-ability",
        "pet-trainer"
      ]
    },
    "clientId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "facts",
        "evidence",
        "sources"
      ],
      "properties": {
        "entityId": {
          "type": "integer",
          "minimum": 1
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "integer"
                }
              }
            ]
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstSeen",
        "lastSeen",
        "observationCount",
        "builds"
      ],
      "properties": {
        "firstSeen": {
          "$ref": "#/$defs/observationPoint"
        },
        "lastSeen": {
          "$ref": "#/$defs/observationPoint"
        },
        "observationCount": {
          "type": "integer",
          "minimum": 1
        },
        "builds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "observationPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "observedAt"
      ],
      "properties": {
        "build": {
          "type": "integer",
          "minimum": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "producer"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "collector",
            "manual",
            "upstream-derived"
          ]
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "producerVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
